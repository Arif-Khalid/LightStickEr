# Token from @BotFather
BOT_TOKEN=123456:your-bot-token-here

# A Telegram user_id that will be recorded as the "owner" of every sticker set
# (required by the Bot API; it does not restrict who can contribute) and is
# also treated as an implicit admin of every pack, bypassing the /grantadmin
# permission checks below.
# Must belong to a real user who has messaged this bot at least once.
# Get your own user_id by messaging @userinfobot.
OWNER_USER_ID=123456789

# Which GCP project's Firestore database to use for pack-admin bookkeeping.
# On Cloud Run this is set automatically - only needed for local development.
# Also run `gcloud auth application-default login` once locally so the
# Firestore client can authenticate the same way it does via the Cloud Run
# service account in production.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# "polling" for local development (default). Set to "webhook" when deploying
# to a host like Cloud Run that expects the container to serve HTTP.
RUN_MODE=polling

# Port the webhook server listens on. Cloud Run sets this automatically -
# only needed for local webhook testing.
PORT=8080

# Optional: a random string Telegram must echo back in the
# X-Telegram-Bot-Api-Secret-Token header, so only real Telegram requests are
# accepted. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
